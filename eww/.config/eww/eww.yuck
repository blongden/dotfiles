;; eww — desktop widgets. Bar stays waybar; this adds rich popovers.
;; wattson: today's Octopus Agile prices (since local midnight) as 48
;; RAG-coloured cells vs the rolling 7-day import average, + solar/grid.
;; Toggled from the waybar custom/wattson module (`eww open --toggle wattson`).

(defpoll wattson :interval "60s"
  :initial '{"rate":0,"next":0,"avg":0,"eff":0,"wk_avg":0,"band":"amber","solar_kwh":0,"solar_w":0,"imported":0,"exported":0,"updated":"—","slots":[]}'
  `~/.config/waybar/scripts/wattson.sh --data 2>/dev/null || echo '{"rate":0,"next":0,"avg":0,"eff":0,"wk_avg":0,"band":"amber","solar_kwh":0,"solar_w":0,"imported":0,"exported":0,"updated":"?","slots":[]}'`)

(defwidget agile-cell [slot]
  (box :class "cell c-${slot.band} ${slot.now ? "now" : ""}"
       :tooltip "${slot.hh}   ${round(slot.p, 1)}p/kWh"))

(defwidget wattson-panel []
  (box :class "wattson" :orientation "v" :space-evenly false :spacing 12
    (box :class "headline" :space-evenly false :spacing 14
      (label :class "rate c-${wattson.band}" :text "${round(wattson.rate, 1)}p")
      (box :orientation "v" :space-evenly false :halign "start" :class "sub"
        (label :halign "start" :text "next  ${round(wattson.next, 1)}p")
        (label :halign "start" :text "today avg  ${round(wattson.avg, 1)}p")
        (label :halign "start" :class "dim" :text "7-day import avg  ${round(wattson.wk_avg, 1)}p")))

    (box :orientation "v" :space-evenly false :spacing 3
      (box :class "chart" :space-evenly true :spacing 2
        (for s in {wattson.slots}
          (agile-cell :slot s)))
      (box :class "ticks" :space-evenly true
        (label :text "00") (label :text "06") (label :text "12")
        (label :text "18") (label :text "24")))

    (box :class "grid" :space-evenly true
      (box :orientation "v" (label :class "k" :text "solar today") (label :text "${round(wattson.solar_kwh, 1)} kWh"))
      (box :orientation "v" (label :class "k" :text "solar now")   (label :text "${wattson.solar_w} W"))
      (box :orientation "v" (label :class "k" :text "import")      (label :text "${round(wattson.imported, 1)} kWh"))
      (box :orientation "v" (label :class "k" :text "export")      (label :text "${round(wattson.exported, 1)} kWh")))

    (label :class "foot" :halign "end" :text "updated ${wattson.updated}")))

(defwindow wattson
  :monitor 0
  :geometry (geometry :x "8px" :y "6px" :anchor "top right" :width "420px")
  :stacking "overlay"
  :focusable false
  (wattson-panel))
