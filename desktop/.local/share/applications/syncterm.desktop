[Desktop Entry]
# SyncTERM BBS client (1.10b dev, built from Synchronet git master; not in
# apt). Binary at ~/.local/bin/syncterm, SVG icons in ~/.local/share/icons.
# Based on upstream's syncterm.desktop.
Type=Application
Name=SyncTERM
GenericName=BBS Terminal
Comment=ANSI-BBS terminal (telnet/SSH/rlogin, Zmodem)
Icon=syncterm
Exec=syncterm %u
Terminal=false
Categories=Network;TerminalEmulator;Dialup;
Keywords=bbs;telnet;ssh;zmodem;ansi;synchronet;
