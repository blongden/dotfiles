# dunst — Tomorrow Night, matched to waybar / wofi / kitty
#   bg  #1d1f21   bg2 #282a2e   line #373b41
#   fg  #c5c8c6   dim #707880
#   red #cc6666  green #b5bd68  yellow #f0c674  blue #81a2be
#   purple #b294bb  aqua #8abeb7  orange #de935f
# dunst reads ONE config (no merge with /etc/xdg), so this is self-contained.

[global]
    monitor = 0
    follow = mouse

    width = 340
    height = (0, 320)
    origin = top-right
    offset = (12, 38)          # clears the 30px waybar (28 + 2px border)
    scale = 0
    notification_limit = 20

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 320
    progress_bar_corner_radius = 3

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 0
    frame_width = 2            # matches waybar's 2px bottom border
    frame_color = "#373b41"
    separator_color = frame
    corner_radius = 6          # matches waybar tooltip radius
    gap_size = 4

    sort = yes
    font = Iosevka Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 96

    sticky_history = yes
    history_length = 25

    dmenu = /usr/bin/wofi --dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corners = all
    ignore_dbusclose = false
    force_xwayland = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1d1f21"
    foreground = "#969896"
    frame_color = "#373b41"
    highlight = "#969896"
    timeout = 8
    default_icon = dialog-information

[urgency_normal]
    background = "#1d1f21"
    foreground = "#c5c8c6"
    frame_color = "#81a2be"
    highlight = "#f0c674"
    timeout = 10
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#1d1f21"
    foreground = "#f0c674"
    frame_color = "#cc6666"
    highlight = "#cc6666"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning
