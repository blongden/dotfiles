{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/submap", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["custom/wattson", "custom/claude", "custom/updates", "cpu", "memory", "temperature", "disk", "network", "bluetooth", "custom/tailscale", "pulseaudio", "backlight", "battery", "custom/weather", "tray", "clock"],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "format": "{id}",
        "persistent-workspaces": { "*": 4 }
    },

    "hyprland/submap": {
        "format": "{}"
    },

    "sway/scratchpad": {
        "format": " {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 70,
        "icon": false,
        "tooltip": false
    },

    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "interval": 1800,
        "exec": "~/.config/waybar/scripts/updates.sh",
        "on-click": "kitty --title 'apt · upgradable' sh -c 'apt list --upgradable 2>/dev/null; echo; printf \"[press a key to close] \"; read x'",
        "on-click-right": "kitty --title 'apt · full-upgrade' sh -c 'sudo apt update && sudo apt full-upgrade; echo; printf \"[done — press a key] \"; read x'; pkill -RTMIN+8 waybar",
        "signal": 8
    },

    "custom/weather": {
        "format": "{}",
        "return-type": "json",
        "interval": 900,
        "exec": "~/.config/waybar/scripts/weather.sh",
        "on-click": "kitty --title 'weather' sh -c 'curl -s \"https://wttr.in/${WEATHER_LOCATION}\"; echo; printf \"[press a key to close] \"; read x'",
        "on-click-right": "pkill -RTMIN+9 waybar",
        "signal": 9
    },

    "custom/tailscale": {
        "format": "{}",
        "return-type": "json",
        "interval": 10,
        "exec": "~/.config/waybar/scripts/tailscale.sh",
        "on-click": "~/.config/waybar/scripts/tailscale.sh toggle-exit",
        "on-click-right": "kitty --title 'tailscale' sh -c 'tailscale status; echo; printf \"[press a key to close] \"; read x'",
        "signal": 10
    },

    "custom/claude": {
        "format": "{}",
        "return-type": "json",
        "interval": 300,
        "exec": "~/.config/waybar/scripts/claude-usage.sh",
        "on-click": "kitty --title 'claude · usage' sh -c '~/.config/waybar/scripts/claude-usage.sh --report; echo; printf \"[press a key to close] \"; read x'; pkill -RTMIN+11 waybar",
        "on-click-right": "~/.config/waybar/scripts/claude-usage.sh --refresh; pkill -RTMIN+11 waybar",
        "signal": 11
    },

    "custom/wattson": {
        "format": "{}",
        "return-type": "json",
        "interval": 1800,
        "exec": "~/.config/waybar/scripts/wattson.sh",
        "on-click": "kitty --title 'wattson · energy' sh -c '~/.config/waybar/scripts/wattson.sh --report; echo; printf \"[press a key to close] \"; read x'; pkill -RTMIN+12 waybar",
        "on-click-right": "~/.config/waybar/scripts/wattson.sh --refresh; pkill -RTMIN+12 waybar",
        "signal": 12
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "states": { "warning": 70, "critical": 92 },
        "on-click": "kitty --title sysmon sh -c 'btop || htop || top'"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB   (swap {swapPercentage}%)",
        "states": { "warning": 78, "critical": 92 }
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 5,
        "critical-threshold": 90,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C"
    },

    "disk": {
        "path": "/",
        "interval": 60,
        "format": " {percentage_used}%",
        "tooltip-format": "{used} used of {total} on {path}  ({free} free)"
    },

    "network": {
        "interval": 5,
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ifname}",
        "format-disconnected": " off",
        "tooltip-format": "{ifname}   {ipaddr}\n {bandwidthDownBits}    {bandwidthUpBits}",
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ifname}   {ipaddr}\n {bandwidthDownBits}    {bandwidthUpBits}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-connected": " {num_connections}",
        "format-connected-battery": " {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\nno devices connected",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-bluetooth": "{icon} {volume}%",
        "format-icons": { "default": ["", "", ""], "headphone": "" },
        "scroll-step": 2,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}   ({power} W)"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "clock": {
        "interval": 30,
        "format": " {:%a %d %b   %H:%M}",
        "format-alt": " {:%H:%M:%S   W%V   %Z}",
        "tooltip-format": "<span size='large' color='#f0c674'>{:%A %e %B %Y}</span>\n<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "format": {
                "months":   "<span color='#f0c674'><b>{}</b></span>",
                "days":     "<span color='#c5c8c6'>{}</span>",
                "weeks":    "<span color='#8abeb7'>{}</span>",
                "weekdays": "<span color='#81a2be'><b>{}</b></span>",
                "today":    "<span color='#cc6666'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
